---
import Base from '../layouts/Base.astro';
import ContentSection from '../components/ContentSection.astro';
import LinkButtons from '../components/LinkButtons.astro';
import VideoList from '../components/VideoList.astro';
import { byOrder, linksIn, loadSheet, sectionsFor } from '../lib/sheet';

const { links, videos, content } = await loadSheet();
const sections = sectionsFor(content, 'about');
const documents = linksIn(links, 'document');
const moreVideos = byOrder(videos.filter((video) => !video.show_on_home));
---

<Base title="About" description="Who we are and how the boosters support the choir program.">
  <h1>About</h1>

  {sections.map((section) => <ContentSection section={section} />)}

  {
    documents.length > 0 && (
      <section aria-labelledby="official-documents">
        <h2 id="official-documents">Official documents</h2>
        <LinkButtons links={documents} />
      </section>
    )
  }

  {
    moreVideos.length > 0 && (
      <section aria-labelledby="videos">
        <h2 id="videos">Videos</h2>
        <VideoList videos={moreVideos} />
      </section>
    )
  }
</Base>
