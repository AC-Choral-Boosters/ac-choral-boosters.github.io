---
import Banner from '../components/Banner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/paths';
import { loadSheet } from '../lib/sheet';
import '../styles/global.css';

interface Props {
  /** Page name, e.g. "Meetings". Omit on the home page. */
  title?: string;
  description: string;
}

const { title, description } = Astro.props;

const { settings } = await loadSheet();
const clubName = settings.club_name;

const pageTitle = title ? `${title} | ${clubName}` : clubName;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(withBase('/images/boosters-logo.jpg'), Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={clubName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header clubName={clubName} />
    <Banner settings={settings} />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer settings={settings} />
  </body>
</html>
