---
import ExternalLink from './ExternalLink.astro';
import type { Settings } from '../lib/schemas';

interface Props {
  settings: Settings;
}

const { banner_enabled, banner_text, banner_link } = Astro.props.settings;
---

{
  banner_enabled && banner_text && (
    <div class="banner container">
      <p>
        <svg class="banner-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="22" height="22">
          <path d="M3 10v4a1 1 0 0 0 1 1h3l6 4V5L7 9H4a1 1 0 0 0-1 1ZM17 8.5a5 5 0 0 1 0 7M19.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>{banner_link ? <ExternalLink href={banner_link}>{banner_text}</ExternalLink> : banner_text}</span>
      </p>
    </div>
  )
}
