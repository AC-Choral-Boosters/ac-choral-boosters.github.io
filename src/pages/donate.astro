---
import Base from '../layouts/Base.astro';
import ContentSection from '../components/ContentSection.astro';
import LinkButtons from '../components/LinkButtons.astro';
import { linksIn, loadSheet, sectionsFor } from '../lib/sheet';

const { settings, links, content } = await loadSheet();
const sections = sectionsFor(content, 'donate');
const donateLinks = linksIn(links, 'donate');
---

<Base title="Donate" description="Donate to support American Canyon High School choir students.">
  <h1>Donate</h1>

  {sections.map((section) => <ContentSection section={section} />)}

  {
    donateLinks.length > 0 && (
      <section aria-labelledby="ways-to-give">
        <h2 id="ways-to-give">Ways to give</h2>
        <LinkButtons links={donateLinks} />
      </section>
    )
  }

  {
    settings.is_501c3 && (
      <p class="tax-note">
        {settings.club_name} is a 501(c)(3) nonprofit{settings.ein && ` (EIN ${settings.ein})`}. Donations may be
        tax-deductible.
      </p>
    )
  }
</Base>
